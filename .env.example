# Where the NAS share is mounted inside the LXC (see docs/deploy.md).
ASSET_NAS_PATH=/mnt/assets

# name=path pairs, separated by ';'. Paths are as seen inside the container: the NAS
# is mounted at /assets. Several roots can point at subfolders, e.g.
# ASSET_ROOTS=art=/assets/Art;music=/assets/Music
ASSET_ROOTS=nas=/assets

# Address the web UI listens on. The UI has no login; 0.0.0.0 = every interface.
# Set the LXC's LAN IP (or 127.0.0.1 behind a proxy) to narrow it.
ASSET_BIND=0.0.0.0
ASSET_PORT=8000
# Rescan every 6 hours. Unchanged files only cost a stat each; archives are relisted only when changed.
SCAN_INTERVAL_SECONDS=21600
# Cap for on-demand thumbnails (archive contact sheets are not counted).
ASSET_THUMB_CACHE_MB=4096
WEB_MEM_LIMIT=2g
SCANNER_MEM_LIMIT=3g
